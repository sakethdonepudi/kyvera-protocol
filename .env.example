# Environment reference (see apps/web/.env.example for the web app)
#
# The web application defaults to the local demo relay only.
# Add public relays only when you intend to query/publish on the public network.
NEXT_PUBLIC_KYVERA_RELAYS=ws://127.0.0.1:7777,ws://localhost:7777

# Network for BCH address validation: mainnet | chipnet
NEXT_PUBLIC_KYVERA_NETWORK=mainnet

# Identifier used in authentication challenges (e.g. the application origin).
NEXT_PUBLIC_KYVERA_DOMAIN=kyvera.local

# CLI example:
#   KYVERA_RELAYS=ws://127.0.0.1:7777 pnpm cli npub1...
