# Web application environment (copy to apps/web/.env.local)
#
# Comma-separated relay list. The default is the local demo relay only.
# Add public relays only when you intend to query/publish on the public network.
NEXT_PUBLIC_KYVERA_RELAYS=ws://127.0.0.1:7777

# mainnet | chipnet
NEXT_PUBLIC_KYVERA_NETWORK=mainnet

# Domain / origin used in authentication challenges.
NEXT_PUBLIC_KYVERA_DOMAIN=kyvera.local
