# Production environment (copy values into Vercel project settings)
# Sensitive auth/payment actions require FULL agreement from every relay here.
#
# Public relays used by the deployed app. The production bundle falls back to
# relay.damus.io + nos.lol if this is omitted, but setting it explicitly is
# strongly recommended. Do not include the local demo relay in production.
NEXT_PUBLIC_KYVERA_RELAYS=wss://nos.lol,wss://relay.primal.net

# mainnet | chipnet
NEXT_PUBLIC_KYVERA_NETWORK=mainnet

# Domain / origin shown in authentication challenges. Use the deployed host.
NEXT_PUBLIC_KYVERA_DOMAIN=kyvera.example

# These are all public build-time values. No secret belongs in a NEXT_PUBLIC_*
# variable. The app has no server-side secret, database or API key.
