{
  "name": "@kyvera/sdk",
  "version": "0.1.0",
  "description": "Developer-facing KYVERA SDK: relay discovery, lifecycle resolution, structured verification and relying-party authentication",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "default": "./dist/discovery.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kyvera/bch": "workspace:*",
    "@kyvera/core": "workspace:*",
    "@kyvera/nostr": "workspace:*",
    "@kyvera/verifier": "workspace:*"
  }
}
